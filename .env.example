# Dominio pubblico del sito (canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://orma-digital-studio.netlify.app

# Modulo contatti → Google Sheet (solo server, NON usare il prefisso NEXT_PUBLIC_)
# URL dell'app web Apps Script, termina con /exec (vedi scripts/google-sheets-contact.gs)
GOOGLE_SHEETS_WEBHOOK_URL=
# Stringa lunga e casuale, identica alla proprietà SHARED_SECRET dello script
GOOGLE_SHEETS_SECRET=
